# Last part of the generated Dockerfile (see base.Dockerfile).

# Run by the capture sidecar of CLAUDE_AIRLOCK_NET_LOG, which has the
# capability for it, a session has not (see claude_airlock/capture.py).
# Here and not in the base, whose layers every feature builds on: what is
# added to the tail rebuilds the tail alone.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tcpdump \
    && rm -rf /var/lib/apt/lists/*

# Claude Code: exact version from npm
ARG CLAUDE_CODE_VERSION=2.1.326

# The host's ~/.claude is shared into the container, but its config stores
# absolute paths under the host home (e.g. plugin marketplace locations).
# Symlink the host home to /home/sandbox so those paths resolve, and the
# container runs with HOME set to the host home (see claude_airlock/session.py).
# Defaults to /home/sandbox, keeping the build a no-op when they already match.
# The launcher folds the home into the image tag, so an image built for
# another home is never reused.
ARG HOST_HOME=/home/sandbox
RUN if [ "$HOST_HOME" != /home/sandbox ]; then \
    mkdir -p "$(dirname "$HOST_HOME")" \
    && ln -s /home/sandbox "$HOST_HOME"; \
    fi

# Same dir as /home/sandbox/.local/bin via the symlink, but /doctor checks PATH for
# the literal $HOME/.local/bin (the host home), so add it to silence the warning.
ENV PATH="${HOST_HOME}/.local/bin:${PATH}"

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

# ~/.cache is mounted as a named volume (see cache_arg in
# claude_airlock/session.py). A new volume
# takes the owner and mode of the directory it covers, so create it open to
# whichever host user the container runs as, the way /tmp is.
# The npm installs above ran as root and left their cache there, which the
# volume would start out with: npm in a session then fails on a cache
# directory it cannot write.
RUN mkdir -p /home/sandbox/.cache \
    && rm -rf /home/sandbox/.cache/npm \
    && chmod 1777 /home/sandbox/.cache

# No program of the image runs as another user than the one that starts
# it. A session cannot gain privileges this way as it is (see
# no-new-privileges in claude_airlock/session.py), this holds without it.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +

USER sandbox
WORKDIR /home/sandbox

# System-level memory: tells Claude which tools this image ships and its
# runtime constraints. Generated by the launcher from CLAUDE-airlock.md and
# the "# claude-feat-md: " lines of the parts that went into this image.
COPY CLAUDE.md /etc/claude-code/CLAUDE.md

# A Claude Code plugin with the language servers this image has, made by the
# launcher from the "# claude-feat-lsp: " lines of its parts and given to
# claude with --plugin-dir. So a session can ask a server where a symbol is
# defined or used without a plugin being enabled on the host, and never has
# one enabled for a server that is not here.
COPY claude.plugin /opt/claude-airlock-plugin

# Rebuilding is the only update path, so disable the in-container auto-updater
# (it fails anyway: the binary lives on the read-only image layer).
ENV DISABLE_AUTOUPDATER=1

ENTRYPOINT ["claude"]
