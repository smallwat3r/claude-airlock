# claude: docker CLI, only when the session was started with CLAUDE_DOCKER_SOCKET: docker ps and docker logs work (not for containers run with a TTY), inspect returns a stub and everything else is denied. CLAUDE_DOCKER_SOCKET=full adds real inspect, stats and top. Never run or build.
RUN curl -fsSL https://download.docker.com/linux/debian/gpg \
    -o /usr/share/keyrings/docker-archive-keyring.asc \
    && echo "deb [arch=$(dpkg --print-architecture) \
    signed-by=/usr/share/keyrings/docker-archive-keyring.asc] \
    https://download.docker.com/linux/debian \
    $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*
