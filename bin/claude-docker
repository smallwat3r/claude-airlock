#!/usr/bin/env bash
# claude-docker - Run Claude Code inside a sandboxed Docker container.
#
# Builds the sandbox image on first use, then runs claude inside a container
# with the project directory mounted read-write and ~/.claude persisted.
#
#   claude-docker [--add-dir DIR]... [--add-dir-ro DIR]... [claude args]...
#   claude-docker --shell [bash args]   bash in the same sandbox, not claude
#   claude-docker --rebuild        force a clean image rebuild, then exit
#   claude-docker --dockerfile     print the generated Dockerfile, then exit
#   claude-docker --net-log        domains the egress filter denied, then exit
#   claude-docker --net-reload     restart the egress filter, then exit
#   claude-docker --worktree [NAME]   second session on its own checkout
#
# --worktree is claude's own flag, forwarded like any other claude arg: it
# creates a git worktree and branch under .claude/worktrees/ in the project,
# which the project mount already covers, so parallel sessions do not share
# a working tree or index.
#
# Extra project directories (e.g. the frontend repo next to this backend)
# are mounted read-write at their host path, get their .env files shadowed
# like the main project's, and are forwarded to claude via --add-dir. Also
# accepted, colon-separated: CLAUDE_DOCKER_EXTRA_DIRS=~/code/frontend
# --add-dir-ro (or CLAUDE_DOCKER_EXTRA_DIRS_RO) does the same read-only, for
# reference code the session should read but never change.
#
# The image is assembled from docker/claude-sandbox: base.Dockerfile, the
# selected features/*.Dockerfile, then tail.Dockerfile (see prepare_image).
#
# Environment, all optional:
#   CLAUDE_DOCKER_FEATURES    features to build in, space or comma separated
#   CLAUDE_DOCKER_NET_FILTER  1 restricts egress to allowed-domains.txt
#   CLAUDE_DOCKER_SSH_AGENT   1 forwards the SSH agent
#   CLAUDE_DOCKER_SOCKET      1 allows docker ps and logs, full adds inspect
#   CLAUDE_DOCKER_RW_CONFIG   1 leaves ~/.claude settings and hooks writable
#   CLAUDE_DOCKER_SHADOW      extra file name globs to hide, colon separated
#   CLAUDE_DOCKER_MEMORY      memory limit
#   CLAUDE_DOCKER_PIDS        process limit
#   CLAUDE_DOCKER_CACHE       0 keeps ~/.cache on a tmpfs, nothing persists
#   CLAUDE_DOCKER_RUNTIME     container runtime, e.g. runsc for gVisor
#   CLAUDE_DOCKER_SHARED_DIR  scratch directory shared between sessions,
#                             empty for none
#
# The built-in defaults are set in one block below, after load_user_config.
# To override them for every session, put NAME=value lines in
# ~/.config/claude-sandbox/config (see load_user_config), the environment
# still wins.

set -euo pipefail

USER_CONF="${XDG_CONFIG_HOME:-${HOME}/.config}/claude-sandbox"
# The settings a config file may hold, without their CLAUDE_DOCKER_ prefix.
# EXTRA_DIRS and EXTRA_DIRS_RO are left out on purpose, what to mount next
# to a project is a per-project choice, not a default for every session.
SETTINGS="FEATURES NET_FILTER SSH_AGENT SOCKET RW_CONFIG SHADOW MEMORY PIDS CACHE RUNTIME SHARED_DIR"

# Take defaults for the CLAUDE_DOCKER_* settings from the user's config
# file: one NAME=value per line, # comments, the value taken literally (no
# quotes, no ~ or variable expansion). A variable already in the
# environment wins, also when set but empty. Nothing is evaluated, and a
# line that is not a known setting aborts: a typo must not silently leave a
# restriction off. Deliberately not read from the project, the session can
# write there and could switch its own sandboxing off for the next run.
load_user_config() {
  local file="${USER_CONF}/config" line name
  [ -f "${file}" ] || return 0
  while IFS= read -r line || [ -n "${line}" ]; do
    [[ "${line}" =~ ^[[:space:]]*(#|$) ]] && continue
    name="${line%%=*}"
    case "${line}" in
      CLAUDE_DOCKER_*=*)
        case " ${SETTINGS} " in
          *" ${name#CLAUDE_DOCKER_} "*) ;;
          *) name="" ;;
        esac ;;
      *) name="" ;;
    esac
    if [ -z "${name}" ]; then
      echo "${file}: not a known setting: ${line}" >&2
      exit 1
    fi
    printenv "${name}" >/dev/null || printf -v "${name}" '%s' "${line#*=}"
  done < "${file}"
}
load_user_config

# The default of every setting, applied when neither the environment nor
# the config file gave a value. The one place to change them, the code below
# reads the variables as they are.
: "${CLAUDE_DOCKER_NET_FILTER:=0}"
: "${CLAUDE_DOCKER_SSH_AGENT:=0}"
: "${CLAUDE_DOCKER_SOCKET:=0}"
: "${CLAUDE_DOCKER_RW_CONFIG:=0}"
: "${CLAUDE_DOCKER_SHADOW:=}"
: "${CLAUDE_DOCKER_MEMORY:=16g}"
: "${CLAUDE_DOCKER_PIDS:=512}"
: "${CLAUDE_DOCKER_CACHE:=1}"
: "${CLAUDE_DOCKER_RUNTIME:=}"
: "${CLAUDE_DOCKER_EXTRA_DIRS:=}"
: "${CLAUDE_DOCKER_EXTRA_DIRS_RO:=}"
# Only when unset, set but empty means no shared directory
DEFAULT_SHARED_DIR="${HOME}/claude-shared"
: "${CLAUDE_DOCKER_SHARED_DIR=${DEFAULT_SHARED_DIR}}"
# CLAUDE_DOCKER_FEATURES has no default here: unset falls back to
# features.txt, then to every feature (see selected_features)

IMAGE_NAME="claude-code-sandbox"
# Sidecar images. They hold the host Docker socket and the egress path, so
# they are pinned by digest (the tag is informative only), refreshed by
# docker/claude-sandbox/update-pins.py.
PROXY_IMAGE="tecnativa/docker-socket-proxy:latest@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459"
SQUID_IMAGE="ubuntu/squid:latest@sha256:6a097f68bae708cedbabd6188d68c7e2e7a38cedd05a176e1cc0ba29e3bbe029"
# One sidecar per socket mode, so sessions in different modes never share
# (see socket_proxy_args). The limited one has its own name on purpose: a
# full-access sidecar left running must not be picked up as the limited one.
SOCKET_MODE="${CLAUDE_DOCKER_SOCKET}"
if [ "${SOCKET_MODE}" = "full" ]; then
  PROXY_NAME="claude-docker-proxy"
else
  PROXY_NAME="claude-docker-ps-proxy"
fi
EGRESS_PROXY="claude-egress-proxy"
DOCKER_SOCK="/var/run/docker.sock"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKERFILE_DIR="${SCRIPT_DIR}/../docker/claude-sandbox"
# Searched in order, so a user feature overrides a bundled one of the same name
FEATURE_DIRS=("${USER_CONF}/features" "${DOCKERFILE_DIR}/features")
CONTAINER_HOME="/home/node"
PROJECT_DIR="$(pwd)"
NET_FILTER="${CLAUDE_DOCKER_NET_FILTER}"

# Filtered mode joins an internal network with no route out, open mode a
# plain bridge network. Both are user-defined so container names resolve.
FILTER_NET="claude-docker-net"
if [ "${NET_FILTER}" = "1" ]; then
  NET="${FILTER_NET}"
else
  NET="claude-docker-open-net"
fi

ACTION=run     # or shell, rebuild, dockerfile, net-log, net-reload
EXTRA_DIRS=()  # host directories mounted alongside the project
RO_DIRS=()     # the subset of EXTRA_DIRS mounted read-only
CLAUDE_ARGS=() # arguments forwarded to claude
DOCKER_ARGS=() # arguments passed to docker run

# Names of every available feature, one per line
available_features() {
  local dir file
  for dir in "${FEATURE_DIRS[@]}"; do
    for file in "${dir}"/*.Dockerfile; do
      [ -f "${file}" ] && basename "${file}" .Dockerfile
    done
  done
  return 0
}

# Names of the selected features, one per line. First match wins:
# CLAUDE_DOCKER_FEATURES (set but empty selects none), then
# ~/.config/claude-sandbox/features.txt (one name per line, # comments),
# then everything available. Sorted, so the same set always generates the
# same Dockerfile whatever order it was written in. Toggling a feature
# rebuilds the ones sorted after it, name a heavy one early if that hurts.
selected_features() {
  local list
  if [ -n "${CLAUDE_DOCKER_FEATURES+x}" ]; then
    list="${CLAUDE_DOCKER_FEATURES}"
  elif [ -f "${USER_CONF}/features.txt" ]; then
    list="$(sed 's/#.*//' "${USER_CONF}/features.txt")"
  else
    list="$(available_features)"
  fi
  printf '%s\n' "${list}" | tr -s ', \t' '\n' | sed '/^$/d' | LC_ALL=C sort -u
}

# Path of the Dockerfile fragment for a feature. The name is validated, it
# ends up in a path and comes from the environment or a config file.
feature_file() { # name
  local dir
  case "$1" in
    *[!a-z0-9_-]*) echo "invalid feature name: $1" >&2; exit 1 ;;
  esac
  for dir in "${FEATURE_DIRS[@]}"; do
    if [ -f "${dir}/$1.Dockerfile" ]; then
      printf '%s\n' "${dir}/$1.Dockerfile"
      return 0
    fi
  done
  echo "unknown feature: $1 (available: $(available_features | LC_ALL=C sort -u | tr '\n' ' '))" >&2
  exit 1
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi
}

# Assemble the Dockerfile and the CLAUDE.md baked into the image from the
# base, the selected features and the tail. The image tag is a hash of both
# plus the host home (the image symlinks it to /home/node), so editing a
# part, changing the selection or moving home rebuilds, with the layer cache,
# and each feature set keeps its own image.
prepare_image() {
  local names name file parts=("${DOCKERFILE_DIR}/base.Dockerfile")
  names="$(selected_features)"
  for name in ${names}; do
    file="$(feature_file "${name}")"
    parts+=("${file}")
  done
  parts+=("${DOCKERFILE_DIR}/tail.Dockerfile")

  DOCKERFILE=""
  for file in "${parts[@]}"; do
    DOCKERFILE+="$(cat "${file}")"$'\n\n'
  done
  # The template ends with a placeholder bullet, visible when the file is
  # read on its own, the generated tool list takes its place
  CLAUDE_MD="$(grep -v '^- _Placeholder:' "${DOCKERFILE_DIR}/CLAUDE-sandbox.md"
    sed -n 's/^# claude: /- /p' "${parts[@]}")"
  IMAGE="${IMAGE_NAME}:$(printf '%s\n' "${HOME}" "${DOCKERFILE}" "${CLAUDE_MD}" \
    | sha256 | cut -c1-12)"
}

build_image() { # [docker build options]
  local context status=0
  echo "Building Claude sandbox image ${IMAGE}..." >&2
  context="$(mktemp -d)"
  printf '%s\n' "${DOCKERFILE}" > "${context}/Dockerfile"
  printf '%s\n' "${CLAUDE_MD}" > "${context}/CLAUDE.md"
  docker build "$@" -t "${IMAGE}" \
    --build-arg HOST_HOME="${HOME}" "${context}" >&2 || status=$?
  rm -rf "${context}"
  return "${status}"
}

ensure_image() {
  docker image inspect "${IMAGE}" >/dev/null 2>&1 || build_image
}

# Refuse the filesystem root, the home directory or any of its parents:
# mounting one read-write would expose the whole home and defeat the sandbox.
refuse_unsafe_dir() {
  case "${HOME}/" in
    "${1%/}/"*)
      echo "refusing to mount $1: it would defeat the sandbox" >&2
      exit 1
      ;;
  esac
}

# Resolve to an absolute path, expanding a literal leading ~ (the shell does
# not expand it in the --add-dir=~/x form).
resolve_dir() {
  local dir="$1"
  # shellcheck disable=SC2088 # matching a literal tilde is the point
  case "${dir}" in
    "~") dir="${HOME}" ;;
    "~/"*) dir="${HOME}${dir#\~}" ;;
  esac
  # CDPATH would make cd echo the resolved path, corrupting the output
  # shellcheck disable=SC1007 # an empty CDPATH for this one command
  CDPATH= cd -- "${dir}" && pwd
}

# Skip duplicates and the project dir itself: docker rejects a repeated
# mount destination, and the project is already mounted.
add_extra_dir() {
  local dir
  dir="$(resolve_dir "$1")"
  refuse_unsafe_dir "${dir}"
  [ "${dir}" = "${PROJECT_DIR}" ] && return 0
  case " ${EXTRA_DIRS[*]-} " in *" ${dir} "*) return 0 ;; esac
  EXTRA_DIRS+=("${dir}")
}

# The scratch directory shared between sessions: ~/claude-shared, or the one
# CLAUDE_DOCKER_SHARED_DIR names, empty for none. The default is skipped
# when missing, one asked for by name goes through the usual checks.
add_shared_dir() {
  local dir="${CLAUDE_DOCKER_SHARED_DIR}"
  [ -n "${dir}" ] || return 0
  if [ "${dir}" != "${DEFAULT_SHARED_DIR}" ] || [ -d "${dir}" ]; then
    add_extra_dir "${dir}"
  fi
}

# Same, mounted read-only. A directory already added read-write stays so.
add_ro_dir() {
  local dir count=${#EXTRA_DIRS[@]}
  dir="$(resolve_dir "$1")"
  add_extra_dir "${dir}"
  if [ "${#EXTRA_DIRS[@]}" -gt "${count}" ]; then
    RO_DIRS+=("${dir}")
  fi
}

is_ro_dir() { # dir
  case " ${RO_DIRS[*]-} " in *" $1 "*) return 0 ;; esac
  return 1
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --rebuild)
        ACTION=rebuild
        shift
        ;;
      --dockerfile)
        ACTION=dockerfile
        shift
        ;;
      --shell | --net-log | --net-reload)
        ACTION="${1#--}"
        shift
        ;;
      --add-dir-ro)
        [ $# -ge 2 ] || { echo "--add-dir-ro requires a path" >&2; exit 1; }
        add_ro_dir "$2"
        shift 2
        ;;
      --add-dir-ro=*)
        add_ro_dir "${1#*=}"
        shift
        ;;
      --add-dir)
        [ $# -ge 2 ] || { echo "--add-dir requires a path" >&2; exit 1; }
        add_extra_dir "$2"
        shift 2
        ;;
      --add-dir=*)
        add_extra_dir "${1#*=}"
        shift
        ;;
      *)
        CLAUDE_ARGS+=("$1")
        shift
        ;;
    esac
  done
}

# Container name: claude-{project}[-{instance}], instance taken from the
# Emacs buffer name (*claude:dir:instance*) so parallel sessions never clash.
container_name() {
  local name
  name="claude-$(basename "${PROJECT_DIR}")"
  if [ -n "${CLAUDE_BUFFER_NAME:-}" ]; then
    local instance="${CLAUDE_BUFFER_NAME##*:}"
    name="${name}-${instance%\*}"
  fi
  name="${name//[^[:alnum:]_.-]/-}"
  # Buffer names are only unique within one Emacs, so a second Emacs (or a
  # plain shell) on the same project asks for a name that is already
  # taken. Step past it rather than fail, the other session is still live.
  local base="${name%-}" n=2
  CONTAINER_NAME="${base}"
  while docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; do
    CONTAINER_NAME="${base}-$((n++))"
  done
}

sidecar_running() { # name
  docker container inspect -f '{{.State.Running}}' "$1" 2>/dev/null | grep -q true
}

# (Re)create sidecar NAME on our network, with the given docker run options
start_sidecar() { # name [docker run options] image
  local name="$1"
  shift
  docker rm -f "${name}" >/dev/null 2>&1 || true
  docker run -d --name "${name}" --network "${NET}" --restart unless-stopped \
    "$@" >/dev/null
}

base_args() {
  local claude_dir="${HOME}/.claude"
  local state_dir="${HOME}/.local/state/claude"
  mkdir -p "${claude_dir}" "${state_dir}"

  # Claude writes its global config atomically (temp file + rename). The
  # default location, a single-file bind mount of ~/.claude.json, can't be
  # renamed over, and the container home is read-only, so every config write
  # is lost and Claude re-prompts (theme, folder trust) on each launch. Point
  # CLAUDE_CONFIG_DIR at the mounted ~/.claude directory instead: there the
  # config is a regular file in a writable mount, so atomic writes persist.
  # Seed it from the host's global config on first use so onboarding, theme
  # and account carry over.
  if [ ! -f "${claude_dir}/.claude.json" ] && [ -f "${HOME}/.claude.json" ]; then
    cp "${HOME}/.claude.json" "${claude_dir}/.claude.json"
  fi

  # shellcheck disable=SC2054 # the commas belong to the tmpfs options
  DOCKER_ARGS+=(
    --rm
    -i
    # Claude runs as PID 1 and does not reap orphaned children; without an
    # init, zombies accumulate and count toward --pids-limit
    --init
    # Run under the host home path (symlinked to /home/node in the image) so
    # absolute paths in the shared ~/.claude config resolve consistently.
    -e HOME="${HOME}"
    -e TERM=xterm-256color
    -e INSIDE_EMACS=
    # Claude's TUI defaults to the alternate screen, which has no scrollback
    # of its own (e.g. inside Emacs eat): everything above the current
    # viewport is gone. Render inline instead so old output stays in the
    # terminal's scrollback.
    -e CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1
    -e CLAUDE_CONFIG_DIR="${CONTAINER_HOME}/.claude"
    # Read by bin/claude-statusline to show a sandbox badge and the
    # network mode in the Claude UI
    -e CLAUDE_DOCKER_SANDBOX="${CONTAINER_NAME}"
    -e CLAUDE_DOCKER_NET_FILTER="${NET_FILTER}"
    # No gpg binary (or key) in the image, so a host gitconfig with
    # commit.gpgsign=true would make every commit fail. Sign the
    # sandbox's commits at review time, before pushing.
    -e GIT_CONFIG_COUNT=2
    -e GIT_CONFIG_KEY_0=commit.gpgsign -e GIT_CONFIG_VALUE_0=false
    -e GIT_CONFIG_KEY_1=tag.gpgsign -e GIT_CONFIG_VALUE_1=false
    -v "${PROJECT_DIR}:${PROJECT_DIR}:z"
    -v "${claude_dir}:${CONTAINER_HOME}/.claude:z"
    # Note: ~/.local/share/claude is NOT mounted. It holds the versioned claude
    # binary the launcher symlinks to; mounting the host's copy shadows the
    # image's baked-in version, dangling the symlink (exit 127). The image owns
    # the version (auto-updater is off, update = rebuild), so keep it
    # self-contained.
    -v "${state_dir}:${CONTAINER_HOME}/.local/state/claude:z"
    # ~/.claude/settings.json runs the statusline from this checkout, which
    # is neither in the image nor (usually) the mounted project, so mount
    # the script alone at its host path, the one settings.json points at.
    -v "${SCRIPT_DIR}/claude-statusline:${SCRIPT_DIR}/claude-statusline:ro,z"
    -w "${PROJECT_DIR}"
    --user "$(id -u):$(id -g)"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --read-only
    # exec where builds and test binaries run; sized so a runaway process
    # cannot eat host RAM through an unbounded tmpfs (default: half of RAM)
    --tmpfs /tmp:exec,size=4g
    --tmpfs "${CONTAINER_HOME}/.config:size=64m"
    --tmpfs "${CONTAINER_HOME}/.npm:exec,size=1g"
    --pids-limit="${CLAUDE_DOCKER_PIDS}"
    # Same value for swap, otherwise docker allows as much swap again on top
    --memory="${CLAUDE_DOCKER_MEMORY}"
    --memory-swap="${CLAUDE_DOCKER_MEMORY}"
    --name "${CONTAINER_NAME}"
  )

  # ~/.cache holds the Go module, uv and npm caches. By default it is a
  # named volume per project, so sessions do not download everything again.
  # Per project on purpose: a shared cache would let a compromised session
  # poison the dependencies of every other project. Unlike the tmpfs it has
  # no size cap, remove the claude-cache-* volumes to reclaim the space.
  if [ "${CLAUDE_DOCKER_CACHE}" = "0" ]; then
    DOCKER_ARGS+=(--tmpfs "${CONTAINER_HOME}/.cache:exec,size=2g")
  else
    local volume
    volume="claude-cache-$(basename "${PROJECT_DIR}")"
    volume="${volume//[^[:alnum:]_.-]/-}-$(printf '%s' "${PROJECT_DIR}" | sha256 | cut -c1-8)"
    DOCKER_ARGS+=(-v "${volume}:${CONTAINER_HOME}/.cache")
  fi

  # A stronger runtime when asked for, e.g. runsc (gVisor), which keeps the
  # container off the host kernel. It must be installed in the daemon.
  if [ -n "${CLAUDE_DOCKER_RUNTIME}" ]; then
    DOCKER_ARGS+=(--runtime "${CLAUDE_DOCKER_RUNTIME}")
  fi

  if [ "${ACTION}" = "shell" ]; then
    DOCKER_ARGS+=(--entrypoint bash)
  fi

  # A TTY only when there is one, so piped and scripted runs (claude -p)
  # work instead of failing with "the input device is not a TTY"
  if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_ARGS+=(-t)
  fi

  # Pass through optional env vars if set. GH_TOKEN is how gh authenticates
  # in here, its config directory is a tmpfs.
  local var
  for var in ANTHROPIC_API_KEY GH_TOKEN CLAUDE_BUFFER_NAME; do
    [ -n "${!var+x}" ] && DOCKER_ARGS+=(-e "${var}")
  done
  return 0
}

# ~/.claude is shared read-write with the host, and settings.json and hooks
# hold commands the host's own claude runs. Left writable, a compromised
# session could plant a hook there and get code execution outside the
# sandbox, so they are mounted read-only on top. The cost: settings changed
# from inside the sandbox are not saved. CLAUDE_DOCKER_RW_CONFIG=1 opts out.
# Plugins stay writable (claude updates them itself), their hook scripts
# are the remaining gap.
protect_config_args() {
  if [ "${CLAUDE_DOCKER_RW_CONFIG}" = "1" ]; then
    # Shown by bin/claude-statusline
    DOCKER_ARGS+=(-e CLAUDE_DOCKER_RW_CONFIG=1)
    return 0
  fi
  local claude_dir="${HOME}/.claude" item
  # Create it so there is something to protect, a missing settings file
  # could otherwise be created from inside the container
  [ -e "${claude_dir}/settings.json" ] || echo '{}' > "${claude_dir}/settings.json"
  for item in settings.json hooks; do
    if [ -e "${claude_dir}/${item}" ]; then
      DOCKER_ARGS+=(-v "${claude_dir}/${item}:${CONTAINER_HOME}/.claude/${item}:ro,z")
    fi
  done
}

extra_dir_args() {
  local dir add_dirs=() shown=()
  for dir in ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"}; do
    if is_ro_dir "${dir}"; then
      DOCKER_ARGS+=(-v "${dir}:${dir}:ro,z")
      shown+=("${dir}(ro)")
    else
      DOCKER_ARGS+=(-v "${dir}:${dir}:z")
      shown+=("${dir}")
    fi
    add_dirs+=(--add-dir "${dir}")
  done
  # --add-dir is variadic, keep it ahead of the user's args so a trailing
  # prompt is never swallowed as another directory. A --shell session runs
  # bash, which takes no --add-dir.
  if [ "${ACTION}" != "shell" ]; then
    CLAUDE_ARGS=(${add_dirs[@]+"${add_dirs[@]}"} ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"})
  fi
  # Read by bin/claude-statusline to list the mounted extra directories
  if [ -n "${shown[*]-}" ]; then
    DOCKER_ARGS+=(-e CLAUDE_DOCKER_DIRS="$(IFS=:; printf '%s' "${shown[*]}")")
  fi
}

# Network: open egress by default. In filtered mode the container joins an
# internal network with no route out, where egress goes through a squid
# sidecar (dual-homed on the internal net and the default bridge) that only
# allows domains listed in docker/claude-sandbox/allowed-domains.txt.
# Filtering is by the host named in the CONNECT request, so it survives CDN
# IP churn.
ensure_network() { # name [docker network create options]
  local name="$1"
  shift
  docker network inspect "${name}" >/dev/null 2>&1 \
    || docker network create "$@" "${name}" >/dev/null
}

# (Re)create the squid sidecar on the internal network, then give it its
# second leg on the default bridge. Labelled with a hash of its config, so
# an edited allowlist is noticed (see egress_proxy_current).
start_egress_proxy() {
  ensure_network "${FILTER_NET}" --internal
  NET="${FILTER_NET}" start_sidecar "${EGRESS_PROXY}" \
    --label "claude-sandbox.config=$(egress_config_hash)" \
    -v "${DOCKERFILE_DIR}/squid.conf:/etc/squid/squid.conf:ro,z" \
    -v "${DOCKERFILE_DIR}/allowed-domains.txt:/etc/squid/allowed-domains.txt:ro,z" \
    "${SQUID_IMAGE}"
  docker network connect bridge "${EGRESS_PROXY}"
}

egress_config_hash() {
  cat "${DOCKERFILE_DIR}/squid.conf" "${DOCKERFILE_DIR}/allowed-domains.txt" \
    | sha256 | cut -c1-16
}

# Running, and started from the config as it is on disk now. A stale proxy
# is replaced on the next filtered start, which briefly drops the
# connections of other filtered sessions.
egress_proxy_current() {
  sidecar_running "${EGRESS_PROXY}" || return 1
  [ "$(docker container inspect \
    -f '{{index .Config.Labels "claude-sandbox.config"}}' "${EGRESS_PROXY}" \
    2>/dev/null)" = "$(egress_config_hash)" ]
}

# Domains the egress filter refused, most frequent first. The quickest way
# to find what a project needs added to allowed-domains.txt.
net_log() {
  sidecar_running "${EGRESS_PROXY}" || {
    echo "the egress proxy is not running (start a CLAUDE_DOCKER_NET_FILTER=1 session first)" >&2
    exit 1
  }
  # Squid's native log: field 4 is the result code, field 7 the URL
  docker exec "${EGRESS_PROXY}" cat /var/log/squid/access.log \
    | awk '$4 ~ /DENIED/ { print $7 }' | sort | uniq -c | sort -rn
}

network_args() {
  ensure_network "${NET}"
  DOCKER_ARGS+=(--network "${NET}")
  [ "${NET_FILTER}" = "1" ] || return 0

  egress_proxy_current || start_egress_proxy

  local proxy_url="http://${EGRESS_PROXY}:3128"
  DOCKER_ARGS+=(
    # Blackhole external DNS: the proxy resolves hostnames (CONNECT
    # carries the name as a string), and squid only looks up domains
    # that pass the allowlist, so the container needs no external DNS.
    # Docker's embedded DNS still answers container names itself and
    # only forwards unknown names upstream; 127.0.0.1 dies on the host,
    # so exfiltration via DNS lookups never leaves the machine.
    --dns 127.0.0.1
    -e HTTP_PROXY="${proxy_url}" -e http_proxy="${proxy_url}"
    -e HTTPS_PROXY="${proxy_url}" -e https_proxy="${proxy_url}"
    -e NO_PROXY="localhost,127.0.0.1,${PROXY_NAME}"
    -e no_proxy="localhost,127.0.0.1,${PROXY_NAME}"
    # Direct port 22 is blocked on the internal net, so tunnel
    # git-over-SSH through the proxy as a CONNECT to :22.
    -e GIT_SSH_COMMAND="ssh -o ProxyCommand=\"nc -X connect -x ${EGRESS_PROXY}:3128 %h %p\""
  )
}

# Docker socket proxy, opt-in (and the docker feature for the CLI). A write
# call to the host daemon (which runs as root) would let this container
# spawn a sibling that mounts the host filesystem, escaping the sandbox
# entirely, so writes are blocked in both modes:
#   CLAUDE_DOCKER_SOCKET=1     docker ps and docker logs only, through our
#                              own HAProxy rules (docker-socket-proxy.cfg)
#   CLAUDE_DOCKER_SOCKET=full  every read under /containers, which adds
#                              inspect, stats and top. inspect shows the
#                              environment of every container on the host,
#                              secrets included.
socket_proxy_args() {
  local mode_args=()
  case "${SOCKET_MODE}" in
    1)
      # The image renders this template into its HAProxy config. No allow
      # switches are passed, so if a future image ignored the template, its
      # stock rules would deny containers rather than open them up.
      mode_args=(
        -v "${DOCKERFILE_DIR}/docker-socket-proxy.cfg:/usr/local/etc/haproxy/haproxy.cfg.template:ro,z"
        -e EVENTS=0
      )
      ;;
    full)
      mode_args=(
        -e CONTAINERS=1 -e LOG=1 -e INFO=1
        -e EXEC=0 -e POST=0 -e IMAGES=0 -e NETWORKS=0 -e VOLUMES=0
        -e SERVICES=0 -e TASKS=0 -e BUILD=0 -e COMMIT=0 -e SWARM=0
      )
      ;;
    *) return 0 ;;
  esac
  [ -S "${DOCKER_SOCK}" ] || return 0
  if ! sidecar_running "${PROXY_NAME}"; then
    start_sidecar "${PROXY_NAME}" \
      -v "${DOCKER_SOCK}:/var/run/docker.sock:ro" \
      "${mode_args[@]}" "${PROXY_IMAGE}"
  fi
  # A proxy left over from a previous run may sit on another network
  # (e.g. after toggling CLAUDE_DOCKER_NET_FILTER); attach it to ours.
  docker network connect "${NET}" "${PROXY_NAME}" 2>/dev/null || true
  DOCKER_ARGS+=(
    -e DOCKER_HOST="tcp://${PROXY_NAME}:2375"
    # Shown by bin/claude-statusline
    -e CLAUDE_DOCKER_SOCKET="${SOCKET_MODE}"
  )
}

# Forward the SSH agent, opt-in with CLAUDE_DOCKER_SSH_AGENT=1: the agent
# lets the container authenticate as you to every host your keys reach, not
# only the git remote. Loading keys with ssh-add -c makes each use ask first.
# Docker Desktop on macOS exposes the host agent at a fixed path, the host
# SSH_AUTH_SOCK is not mountable there.
ssh_agent_args() {
  [ "${CLAUDE_DOCKER_SSH_AGENT}" = "1" ] || return 0
  local macos_sock="/run/host-services/ssh-auth.sock"
  if [ "$(uname)" = "Darwin" ] && [ -e "${macos_sock}" ]; then
    DOCKER_ARGS+=(-v "${macos_sock}:/tmp/ssh-agent.sock")
  elif [ -n "${SSH_AUTH_SOCK:-}" ]; then
    DOCKER_ARGS+=(-v "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock:z")
  else
    return 0
  fi
  # The second one is shown by bin/claude-statusline
  DOCKER_ARGS+=(-e SSH_AUTH_SOCK=/tmp/ssh-agent.sock -e CLAUDE_DOCKER_SSH_AGENT=1)
}

# Forward git config read-only
git_config_args() {
  if [ -f "${HOME}/.gitconfig" ]; then
    DOCKER_ARGS+=(-v "${HOME}/.gitconfig:${CONTAINER_HOME}/.gitconfig:ro,z")
  fi
  local xdg_git="${XDG_CONFIG_HOME:-${HOME}/.config}/git"
  if [ -d "${xdg_git}" ]; then
    DOCKER_ARGS+=(-v "${xdg_git}:${CONTAINER_HOME}/.config/git:ro,z")
  fi
  # Files pulled in with include/includeIf (e.g. a work identity under
  # "gitdir:~/work/") live outside the mounts, so without this they silently
  # never apply. Mounted at their host path, the one the config refers to.
  # Relative paths are taken from the home directory, where ~/.gitconfig is.
  local path
  while IFS= read -r path; do
    # shellcheck disable=SC2088 # matching a literal tilde is the point
    case "${path}" in
      "~/"*) path="${HOME}${path#\~}" ;;
      /*) ;;
      *) path="${HOME}/${path}" ;;
    esac
    case "${path}" in
      "${HOME}/.gitconfig" | "${xdg_git}/"*) continue ;;
    esac
    if [ -f "${path}" ]; then
      DOCKER_ARGS+=(-v "${path}:${path}:ro,z")
    fi
  done < <(git config --global --get-regexp '^include(if\..*)?\.path$' \
    2>/dev/null | cut -d' ' -f2-)
  return 0
}

# Shadow .env files (and direnv's .envrc, which commonly exports secrets,
# plus .netrc and .pypirc, which hold nothing but credentials) so they are
# never visible inside the container. Template files (.env.example and
# friends) stay readable, they exist to be read and hold no secrets. Files
# only: a .env directory (some virtualenvs) cannot take a /dev/null bind
# mount and would abort the run. CLAUDE_DOCKER_SHADOW adds name globs,
# e.g. "*.pem:.npmrc". The whole tree is walked on purpose, pruning more
# directories would be faster but could leave a real secret visible.
shadow_env_files() {
  local envfile pattern extra=() names=(
    -name '.env' -o -name '.env.*' -o -name '.envrc'
    -o -name '.netrc' -o -name '.pypirc'
  )
  IFS=':' read -ra extra <<< "${CLAUDE_DOCKER_SHADOW}"
  for pattern in ${extra[@]+"${extra[@]}"}; do
    if [ -n "${pattern}" ]; then
      names+=(-o -name "${pattern}")
    fi
  done
  while IFS= read -r -d '' envfile; do
    DOCKER_ARGS+=(-v "/dev/null:${envfile}:ro")
  done < <(find "${PROJECT_DIR}" ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"} \
    \( -name node_modules -o -name .git \) -prune -o \
    -type f \( "${names[@]}" \) \
    ! -name '.env.example' ! -name '.env.sample' ! -name '.env.template' \
    -print0 2>/dev/null)
}

# Fingerprint of the files in the mounted directories that run commands on
# the host once the session is over: git config and hooks, and the project's
# Claude settings (hooks, statusline). They have to stay writable for git
# and claude to work, so instead of locking them the launcher compares this
# before and after a session (see report_tampering). One "hash path" line
# per file. Branch tracking entries are left out of the git config hash,
# they change on every push -u or checkout and cannot run anything.
host_exec_fingerprint() {
  local dir file
  for dir in "${PROJECT_DIR}" ${EXTRA_DIRS[@]+"${EXTRA_DIRS[@]}"}; do
    file="${dir}/.git/config"
    if [ -f "${file}" ]; then
      printf '%s %s\n' "$({ git config --file "${file}" --list 2>/dev/null \
        || cat "${file}"; } | grep -v '^branch\.' | sha256 | cut -c1-16)" "${file}"
    fi
    while IFS= read -r -d '' file; do
      printf '%s %s\n' "$(sha256 < "${file}" | cut -c1-16)" "${file}"
    done < <(find "${dir}/.git/hooks" "${dir}/.claude/settings.json" \
      "${dir}/.claude/settings.local.json" -type f -print0 2>/dev/null)
  done
  return 0
}

report_tampering() { # fingerprint taken before the session
  local after
  after="$(host_exec_fingerprint)"
  [ "$1" = "${after}" ] && return 0
  {
    echo "claude-docker: this session changed files that can run commands on the host:"
    # Lines present on one side only are the changed, added or removed files
    printf '%s\n%s\n' "$1" "${after}" | sort | uniq -u | cut -d' ' -f2- \
      | sort -u | sed 's/^/  /'
    echo "Review them before using git or claude there outside the sandbox."
  } >&2
}

main() {
  add_shared_dir
  if [ -n "${CLAUDE_DOCKER_EXTRA_DIRS}" ]; then
    local dirs dir
    IFS=':' read -ra dirs <<< "${CLAUDE_DOCKER_EXTRA_DIRS}"
    for dir in "${dirs[@]}"; do
      [ -n "${dir}" ] && add_extra_dir "${dir}"
    done
  fi
  if [ -n "${CLAUDE_DOCKER_EXTRA_DIRS_RO}" ]; then
    local ro_dirs ro_dir
    IFS=':' read -ra ro_dirs <<< "${CLAUDE_DOCKER_EXTRA_DIRS_RO}"
    for ro_dir in "${ro_dirs[@]}"; do
      [ -n "${ro_dir}" ] && add_ro_dir "${ro_dir}"
    done
  fi
  parse_args "$@"
  case "${ACTION}" in
    net-log)
      net_log
      exit 0
      ;;
    net-reload)
      start_egress_proxy
      exit 0
      ;;
  esac
  prepare_image
  case "${ACTION}" in
    dockerfile)
      printf '%s\n' "${DOCKERFILE}"
      exit 0
      ;;
    rebuild)
      build_image --no-cache
      exit 0
      ;;
  esac
  refuse_unsafe_dir "${PROJECT_DIR}"
  ensure_image
  container_name

  base_args
  protect_config_args
  extra_dir_args
  network_args
  socket_proxy_args
  ssh_agent_args
  git_config_args
  shadow_env_files

  # Not exec: the launcher has to outlive the session to check what it left
  local before status=0
  before="$(host_exec_fingerprint)"
  docker run "${DOCKER_ARGS[@]}" "${IMAGE}" \
    ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} || status=$?
  report_tampering "${before}"
  exit "${status}"
}

# Sourced by test/launcher-test.sh to call the functions directly
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
