#!/usr/bin/env bash
# Claude Code statusline, for its native UI. Shows the model, the used
# session limits (5h and 7d rate-limit windows), and inside a claude-airlock
# container a sandbox badge (the container name, exported by
# bin/claude-airlock), the network mode, the opt-in doors that are open and
# the extra mounted directories. Outside the sandbox those are simply absent.
#
# Not run in line mode, which claude-airlock sessions use unless
# CLAUDE_AIRLOCK_LINE_MODE=0: the chat writes a status line of its own there,
# with /status for the rest.

set -u

input=$(cat)
parts=()

fields=()
while IFS= read -r field; do
  fields+=("${field}")
done < <(
  jq -r '(.model.display_name // "?"),
         (.rate_limits.five_hour.used_percentage // -1),
         (.rate_limits.five_hour.resets_at // 0),
         (.rate_limits.seven_day.used_percentage // -1)' <<<"${input}"
)
model=${fields[0]:-?} five_used=${fields[1]:--1}
five_resets=${fields[2]:-0} seven_used=${fields[3]:--1}

parts+=("$(printf '\033[1m%s\033[0m' "${model}")")

# One limit segment: dim normally, yellow past 70% used, red past 90%
limit_part() { # label used_pct [resets_epoch]
  local label=$1 used=${2%%.*} extra=""
  [ "${used}" -lt 0 ] && return
  local colour='\033[2m'
  [ "${used}" -ge 70 ] && colour='\033[33m'
  [ "${used}" -ge 90 ] && colour='\033[31m'
  # GNU date inside the sandbox, BSD date when run on the macOS host
  [ "${3:-0}" -gt 0 ] && extra=" $(date -d "@$3" +%H:%M 2>/dev/null || date -r "$3" +%H:%M)"
  parts+=("$(printf "${colour}%s:%s%% used%s\033[0m" "${label}" "${used}" "${extra}")")
}

limit_part 5h "${five_used}" "${five_resets}"
limit_part 7d "${seven_used}"

if [ -n "${CLAUDE_AIRLOCK_SANDBOX:-}" ]; then
  parts+=("$(printf '\033[1;32m[%s]\033[0m' "${CLAUDE_AIRLOCK_SANDBOX}")")
  # Network mode: dim when egress is filtered, yellow when open
  if [ "${CLAUDE_AIRLOCK_NET_FILTER:-0}" = "1" ]; then
    parts+=("$(printf '\033[2mnet:filtered\033[0m')")
  else
    parts+=("$(printf '\033[33mnet:open\033[0m')")
  fi
  # The doors this session was started with, absent when closed. Yellow for
  # the ones that widen what a session can reach, red for full inspect,
  # which exposes the environment of every container on the host.
  if [ "${CLAUDE_AIRLOCK_SSH_AGENT:-0}" = "1" ]; then
    parts+=("$(printf '\033[33mssh-agent\033[0m')")
  fi
  case "${CLAUDE_AIRLOCK_DOCKER_SOCKET:-0}" in
    1) parts+=("$(printf '\033[33mdocker:ps\033[0m')") ;;
    full) parts+=("$(printf '\033[31mdocker:full\033[0m')") ;;
  esac
  if [ "${CLAUDE_AIRLOCK_RW_CONFIG:-0}" = "1" ]; then
    parts+=("$(printf '\033[33mconfig:rw\033[0m')")
  fi
  if [ "${CLAUDE_AIRLOCK_SHARED_HISTORY:-0}" = "1" ]; then
    parts+=("$(printf '\033[33mhistory:all\033[0m')")
  fi
  if [ -n "${CLAUDE_AIRLOCK_DIRS:-}" ]; then
    dirs="${CLAUDE_AIRLOCK_DIRS//:/ }"
    dirs="${dirs//${HOME}/\~}"
    parts+=("$(printf '\033[2mdirs: %s\033[0m' "${dirs}")")
  fi
fi

printf '%s\n' "${parts[*]-}"
